rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Authentication Helper
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Member Record Retrieval & Membership Check
    function isRegisteredMember(workspaceId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function getMember(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data;
    }

    // 3. Workspace Owner / Founders
    function isWorkspaceOwner(workspaceId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
         get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid) ||
        (isRegisteredMember(workspaceId) && getMember(workspaceId).role in ['owner', 'co-founder', 'co-owner'])
      );
    }

    // 4. Workspace Administrators
    function isWorkspaceAdmin(workspaceId) {
      return isAuthenticated() && (
        isWorkspaceOwner(workspaceId) ||
        (isRegisteredMember(workspaceId) && getMember(workspaceId).role in ['admin'])
      );
    }

    // 5. Internal Agency Team Member (Full internal access)
    function isInternalTeamMember(workspaceId) {
      return isRegisteredMember(workspaceId) &&
        getMember(workspaceId).role in ['owner', 'co-founder', 'co-owner', 'admin', 'member', 'viewer'];
    }

    // 6. Verified Client User (client_admin or client_guest)
    function isClientUser(workspaceId) {
      return isRegisteredMember(workspaceId) &&
        getMember(workspaceId).role in ['client_admin', 'client_guest'];
    }

    // 7. Verify Client Organization Portal Access Status (Suspended/Revoked check)
    function isClientPortalActive(workspaceId, clientId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/clients/$(clientId)) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)/clients/$(clientId)).data.portalAccessStatus != 'Revoked' &&
        (!('portalSettings' in get(/databases/$(database)/documents/workspaces/$(workspaceId)/clients/$(clientId)).data) ||
         get(/databases/$(database)/documents/workspaces/$(workspaceId)/clients/$(clientId)).data.portalSettings.enabled == true);
    }

    // 8. Client Organization Authorization Guard:
    // Requires that the client user's registered clientId strictly matches the target clientId
    // and the client organization is active (not revoked or offline)
    function isAuthorizedClient(workspaceId, clientId) {
      return isAuthenticated() &&
        clientId != null &&
        isClientUser(workspaceId) &&
        getMember(workspaceId).clientId == clientId &&
        isClientPortalActive(workspaceId, clientId);
    }

    // 9. Genuine Invitation Validation Guard:
    // Strictly verifies that a genuine admin-created invitation exists matching the user's email,
    // clientId, and role. Prevents self-assigning arbitrary roles or client organizations.
    function isValidClientInvitation(workspaceId, memberId, memberData) {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        memberData.email == request.auth.token.email &&
        (
          // Option A: Explicit invitationId provided in member document
          ('invitationId' in memberData &&
           exists(/databases/$(database)/documents/workspaces/$(workspaceId)/clientPortalUsers/$(memberData.invitationId)) &&
           get(/databases/$(database)/documents/workspaces/$(workspaceId)/clientPortalUsers/$(memberData.invitationId)).data.email == request.auth.token.email &&
           get(/databases/$(database)/documents/workspaces/$(workspaceId)/clientPortalUsers/$(memberData.invitationId)).data.clientId == memberData.clientId &&
           get(/databases/$(database)/documents/workspaces/$(workspaceId)/clientPortalUsers/$(memberData.invitationId)).data.role == memberData.role &&
           get(/databases/$(database)/documents/workspaces/$(workspaceId)/clientPortalUsers/$(memberData.invitationId)).data.status != 'revoked') ||
          // Option B: Invitation document keyed directly by member UID
          (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/clientPortalUsers/$(memberId)) &&
           get(/databases/$(database)/documents/workspaces/$(workspaceId)/clientPortalUsers/$(memberId)).data.email == request.auth.token.email &&
           get(/databases/$(database)/documents/workspaces/$(workspaceId)/clientPortalUsers/$(memberId)).data.clientId == memberData.clientId &&
           get(/databases/$(database)/documents/workspaces/$(workspaceId)/clientPortalUsers/$(memberId)).data.role == memberData.role &&
           get(/databases/$(database)/documents/workspaces/$(workspaceId)/clientPortalUsers/$(memberId)).data.status != 'revoked')
        );
    }

    // System probe / status check - requires authenticated user, never public
    match /system/ping {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // User profile document (Self-managed only)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Workspaces collection
    match /workspaces/{workspaceId} {
      allow read: if isInternalTeamMember(workspaceId) || isClientUser(workspaceId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isWorkspaceAdmin(workspaceId);

      // Members Management (Prevents self-escalation and arbitrary client assignment)
      match /members/{memberId} {
        allow read: if (isAuthenticated() && request.auth.uid == memberId) || isInternalTeamMember(workspaceId);
        allow create: if isWorkspaceAdmin(workspaceId) || (
          // Case 1: Workspace owner creating their initial owner membership
          isAuthenticated() &&
          request.auth.uid == memberId &&
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid &&
          request.resource.data.role in ['owner', 'co-founder', 'admin']
        ) || (
          // Case 2: Client representative accepting a genuine invitation created by an authorized admin
          isAuthenticated() &&
          request.auth.uid == memberId &&
          request.resource.data.role in ['client_admin', 'client_guest'] &&
          'clientId' in request.resource.data &&
          isValidClientInvitation(workspaceId, memberId, request.resource.data)
        );
        allow update: if isWorkspaceAdmin(workspaceId);
        allow delete: if isWorkspaceAdmin(workspaceId);
      }

      // Client Organization Directory
      match /clients/{clientId} {
        allow read: if isInternalTeamMember(workspaceId) || isAuthorizedClient(workspaceId, clientId);
        allow write: if isWorkspaceAdmin(workspaceId) || (isInternalTeamMember(workspaceId) && getMember(workspaceId).role != 'viewer');
      }

      // Client Portal Invited Users
      match /clientPortalUsers/{portalUserId} {
        allow read: if isInternalTeamMember(workspaceId) || 
          (isAuthenticated() && request.auth.token.email != null && resource.data.email == request.auth.token.email) ||
          (isAuthorizedClient(workspaceId, resource.data.clientId));
        allow create: if isWorkspaceAdmin(workspaceId);
        allow update: if isWorkspaceAdmin(workspaceId) || (
          isAuthenticated() &&
          request.auth.token.email != null &&
          resource.data.email == request.auth.token.email &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.clientId == resource.data.clientId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status in ['invited', 'active'] &&
          resource.data.status != 'revoked'
        );
        allow delete: if isWorkspaceAdmin(workspaceId);
      }

      // Pipeline Leads / Deals (Isolated per client organization)
      match /leads/{leadId} {
        allow read: if isInternalTeamMember(workspaceId) || isAuthorizedClient(workspaceId, resource.data.clientId);
        allow write: if isInternalTeamMember(workspaceId) && getMember(workspaceId).role != 'viewer';
      }

      // Outreach Activities (Isolated per client organization)
      match /activities/{activityId} {
        allow read: if isInternalTeamMember(workspaceId) || isAuthorizedClient(workspaceId, resource.data.clientId);
        allow write: if isInternalTeamMember(workspaceId) && getMember(workspaceId).role != 'viewer';
      }

      // Meetings (Isolated per client organization)
      match /meetings/{meetingId} {
        allow read: if isInternalTeamMember(workspaceId) || isAuthorizedClient(workspaceId, resource.data.relatedClientId);
        allow write: if isInternalTeamMember(workspaceId) && getMember(workspaceId).role != 'viewer';
      }

      // Delivery Projects & Milestones (Isolated per client organization)
      match /projects/{projectId} {
        allow read: if isInternalTeamMember(workspaceId) || isAuthorizedClient(workspaceId, resource.data.clientId);
        allow write: if isInternalTeamMember(workspaceId) && getMember(workspaceId).role != 'viewer';
      }

      // ========================================================
      // INTERNAL ONLY COLLECTIONS (Strictly forbidden to clients)
      // ========================================================
      match /companies/{companyId} {
        allow read, write: if isInternalTeamMember(workspaceId);
      }
      match /contacts/{contactId} {
        allow read, write: if isInternalTeamMember(workspaceId);
      }
      match /tasks/{taskId} {
        allow read, write: if isInternalTeamMember(workspaceId);
      }
      match /proposals/{proposalId} {
        allow read, write: if isInternalTeamMember(workspaceId);
      }
      match /contentItems/{contentId} {
        allow read, write: if isInternalTeamMember(workspaceId);
      }
      match /customModules/{moduleId} {
        allow read, write: if isInternalTeamMember(workspaceId);
      }
      match /customRecords/{recordId} {
        allow read, write: if isInternalTeamMember(workspaceId);
      }
      match /outreachSources/{sourceId} {
        allow read, write: if isInternalTeamMember(workspaceId);
      }
      match /automationRules/{ruleId} {
        allow read, write: if isInternalTeamMember(workspaceId);
      }
      match /integrations/{integrationId} {
        allow read, write: if isInternalTeamMember(workspaceId);
      }
      match /pages/{pageId} {
        allow read, write: if isInternalTeamMember(workspaceId);
      }
      match /teamMembers/{teamMemberId} {
        allow read, write: if isInternalTeamMember(workspaceId);
      }
      match /kpiTargets/{targetId} {
        allow read, write: if isInternalTeamMember(workspaceId);
      }
    }
  }
}
